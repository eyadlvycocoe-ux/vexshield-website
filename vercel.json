{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/license/redeem",
      "destination": "/api/license-redeem.js"
    },
    {
      "source": "/api/license-redeem",
      "destination": "/api/license-redeem.js"
    },
    {
      "source": "/api/db/:table",
      "destination": "/api/db.js?table=:table"
    },
    {
      "source": "/api/functions/report",
      "destination": "/api/report.js?route=report"
    },
    {
      "source": "/api/report",
      "destination": "/api/report.js?route=report"
    },
    {
      "source": "/api/functions/live-monitoring",
      "destination": "/api/report.js?action=monitoring"
    },
    {
      "source": "/api/functions/server-command",
      "destination": "/api/report.js?route=server-command"
    },
    {
      "source": "/api/public/global-blacklist.json",
      "destination": "/global-blacklist.json"
    },
    {
      "source": "/api/auth/server-session",
      "destination": "/api/auth/session.js?view=server_session"
    },
    {
      "source": "/api/auth/server-permissions",
      "destination": "/api/auth/session.js?view=server_permissions"
    },
    {
      "source": "/api/users/me/dashboard-servers",
      "destination": "/api/auth/session.js?view=servers"
    },
    {
      "source": "/api/admin/servers",
      "destination": "/api/auth/session.js?view=admin_servers"
    },
    {
      "source": "/api/v1/verification/config/hard-link-server-verification-lvkWoc9AgIxFoWLTc8hCC52AOMB3ZhPkZRvQFsg.json",
      "destination": "/licenses-secret-x8f9v2m4p1q7z3w5.json"
    },
    {
      "source": "/map-tiles/satellite/:path*",
      "destination": "/map-tiles/satelite/:path*"
    },
    {
      "source": "/((?!api/|3dmap|map/|map-tiles|vendor|assets|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
